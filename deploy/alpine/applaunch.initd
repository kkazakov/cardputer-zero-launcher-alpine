#!/sbin/openrc-run
# deploy/alpine/applaunch.initd — OpenRC service for APPLaunch on Alpine.
#
# The upstream deployment runs APPLaunch as a systemd user service on
# Raspberry Pi OS. On Alpine (OpenRC) the launcher runs as the root user of
# the console image: this is a single-user pocket device, the stock sudo /
# polkit approval layer does not exist here, and every privileged surface
# the launcher touches (rfkill, wpa_ctrl over the NetworkManager-managed
# supplicant, ALSA mixer state, i2c, /dev/fb*, settimeofday) is expected to
# work without a prompt.
#
# Console ownership: the internal LCD (fb_st7789v fbtft, /dev/fb1) belongs
# to the launcher; the kernel console stays on HDMI (fbcon=map:0). Do NOT
# run a getty on the panel and do NOT blank fbcon while the launcher runs
# (fbcon blanking drives the fbtft backlight off).
#
# Resource root is fixed at /usr/share/APPLaunch (kAppRoot in
# ext_components/cp0_lvgl/src/cp0/cp0_lvgl_filesystem.cpp).

description="M5CardputerZero APPLaunch launcher UI"

command="/usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch"
command_background="yes"
pidfile="/run/applaunch.pid"
directory="/usr/share/APPLaunch"

# The launcher reads the raw evdev keypad directly; stray keystrokes would
# otherwise land on the active VT's getty and repaint the kernel console.
# Set CONSOLE to a VT that no getty uses while the launcher is up.
output_log="/var/log/applaunch.log"
error_log="/var/log/applaunch.log"

depend() {
    need localmount
    # udev settles /dev/input/by-path for the keypad; dbus + bluetooth
    # serve the launcher's Bluetooth settings; NetworkManager owns wlan0.
    after bootmisc udev dbus networkmanager bluetooth cpz-audio cpz-leds
}

start_pre() {
    checkpath -f -m 0644 /var/log/applaunch.log
    # /var/lib/applaunch: launcher settings + config.json live here.
    checkpath -d -m 0755 /var/lib/applaunch
    # The framebuffer auto-detection greps /proc/fb for the ST7789 fbtft
    # device; fail fast with a readable message if the panel is absent.
    if ! grep -q st7789 /proc/fb 2>/dev/null; then
        eerror "no ST7789 fbtft framebuffer in /proc/fb — panel overlay not loaded?"
        return 1
    fi
}
